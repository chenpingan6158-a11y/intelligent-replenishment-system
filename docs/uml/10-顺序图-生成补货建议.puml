@startuml
skinparam backgroundColor #FFFFFF
actor 店长 as SM
participant "前端页面\n(智能补货视图)" as FE
participant "replenishment 路由" as RT
participant "replenishment.py" as SV
participant "forecast.py\n(纯函数)" as FC
participant "units.py" as UN
database "数据库" as DB

SM -> FE : 打开「智能补货」页
FE -> RT : GET /api/replenishment/suggestions?store_id=1
RT -> SV : suggestions_for_store(db, store_id, only_needed)
SV -> DB : 查询门店在售商品清单
DB --> SV : Product 列表
loop 每个商品
  SV -> SV : build_suggestion(db, store_id, product_id)
  SV -> DB : history_for() 取近 N 天消耗(ConsumptionDaily)
  SV -> DB : in_transit_base() 取在途量
  SV -> DB : 取 ReplenishmentPolicy 策略参数
  DB --> SV : 历史序列 / 在途 / 策略
  SV -> SV : 组装 SuggestionInput
  SV -> FC : compute_suggestion(inp)
  FC -> FC : build_forecast(inp)
  note right of FC
    基线 = 有效日消耗均值
    星期因子 = 各星期均值 / 总体均值(截断 0.5~2.0)
    趋势 = 最小二乘斜率 / 基线(截断 ±2%)
    预测需求 = Σ 逐日预测(覆盖提前期+订货周期)
    安全库存 = z × σ × √提前期
    ROP = 提前期需求 + 安全库存
    冷启动：有效天数 < 7 时降级为近 7 日均值
  end note
  FC --> SV : Suggestion(含 detail 明细与 reason)
  SV -> UN : humanize(product, 建议量)
  UN --> SV : "11 箱"
end
SV --> RT : list[Suggestion]
RT --> FE : JSON 信封响应
FE --> SM : 建议表(可展开推导依据)
@enduml
