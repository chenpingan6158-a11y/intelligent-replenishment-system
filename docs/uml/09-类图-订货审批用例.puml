@startuml
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
hide empty members
class OrderRouter {
  +POST /orders
  +POST /orders/{id}/submit
  +POST /orders/{id}/approve
  +POST /orders/{id}/reject
  +POST /orders/{id}/confirm
  +POST /orders/{id}/receive
}
class "ordering.py" as OrderingModule {
  <<module>>
  +create_order(db, store_id, items, user) : PurchaseOrder
  +submit_order(db, order, user)
  +requires_approval(db, store_id, items, total_cents) : (bool, list[str])
  -_deviation_ratio(items) : float
  +approve_order(db, order, user, opinion)
  +reject_order(db, order, user, opinion)
  +confirm_order(db, order, user)
  +receive_order(db, order, items, user)
  +close_order(db, order, user)
  +can_transition(old, new) : bool
  -_assert_transition(old, new)
}
class "inventory.py" as InventoryModule {
  <<module>>
  +receive(db, store_id, items, ...) : 生成批次入库
}
class ApprovalRules {
  <<BR-07 规则（requires_approval 内实现）>>
  1. 金额 > 500 元（APPROVAL_AMOUNT_THRESHOLD_CENTS）
  2. 偏离建议量 > 50%（APPROVAL_DEVIATION_RATIO）
  3. 订货量超过 ReplenishmentPolicy.max_stock_base
}
class OrderStatus {
  <<状态枚举 · can_transition 约束>>
  DRAFT → SUBMITTED
  SUBMITTED → APPROVED / REJECTED
  APPROVED → CONFIRMED
  CONFIRMED → RECEIVED
  RECEIVED → CLOSED / CANCELLED
}
class "PurchaseOrder" as PO <<entity>> {
  +order_no
  +status
  +total_cents
  +store_id
  +created_by
  +submitted_at
  +expected_delivery_date
  +version
}
class "PurchaseOrderItem" as OI <<entity>> {
  +suggest_qty_base
  +order_qty_base
  +received_qty_base
  +unit_price_cents
  +amount_cents
  +adjust_reason
}
class ApprovalRecord <<entity>> {
  +order_id
  +action
  +operator_id
  +opinion
  +created_at
}
class "Store" as ST
class "Product" as P
class "Stock" as SK

OrderRouter ..> OrderingModule
OrderingModule ..> PO
OrderingModule ..> OI
OrderingModule ..> ApprovalRules : requires_approval 判定
OrderingModule ..> OrderStatus : can_transition 约束流转
OrderingModule ..> ApprovalRecord : 审批留痕
OrderingModule ..> InventoryModule : 收货入库
PO "1" *-- "1..*" OI
PO "1" -- "*" ApprovalRecord
PO ..> ST : store_id
OI ..> P : product_id
P ..> SK : 库存联动
@enduml
