@startuml
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
package "边界类（接口层）" {
  class AuthRouter {
    +login()
    +register()
    +options()
  }
  class ReplenishmentRouter {
    +suggestions()
    +detail()
    +backtest()
  }
  class OrderRouter {
    +create()
    +submit()
    +approve()
    +confirm()
    +receive()
  }
  class InventoryRouter {
    +receive()
    +outbound()
    +stocktake()
    +transfer()
  }
  class DashboardRouter {
    +overview()
    +alerts()
  }
  class MasterRouter {
    +products()
    +users()
    +userStatus()
  }
}
package "控制类（服务层）" {
  class "forecast.py" as ForecastModule {
    <<module>>
    +weekday_factors()
    +build_forecast()
    +compute_suggestion()
    +backtest()
  }
  class ReplenishmentService {
    +build_suggestion()
    +suggestions_for_store()
    +in_transit_base()
  }
  class OrderingService {
    +create_order()
    +submit_order()
    +approve_order()
    +reject_order()
    +confirm_order()
    +receive_order()
    +close_order()
  }
  class InventoryService {
    +receive()
    +outbound()
    +loss()
    +create_stocktake()
    +confirm_stocktake()
    +transfer()
  }
  class AlertingService {
    +scan_store()
    +scan_all()
    +handle_alert()
  }
  class MetricsService {
    +overview()
  }
  class UnitsService {
    +to_base()
    +to_order_unit()
    +humanize()
  }
}
package "实体类（持久层）" {
  class User {
    +id
    +username
    +role
    +store_id
  }
  class Store {
    +id
    +name
    +region_id
  }
  class Product {
    +id
    +name
    +base_unit
    +moq
  }
  class Stock {
    +qty_base
    +locked_base
  }
  class Batch {
    +qty_base
    +expire_date
  }
  class StockMovement {
    +movement_type
    +qty_base
  }
  class SalesDaily {
    +sales_base
    +consumed_base
  }
  class PurchaseOrder {
    +order_no
    +status
    +total_cents
  }
  class OrderItem {
    +order_qty
    +received_qty
  }
  class Alert {
    +alert_type
    +severity
    +status
  }
}

AuthRouter ..> User
ReplenishmentRouter ..> ReplenishmentService
OrderRouter ..> OrderingService
InventoryRouter ..> InventoryService
DashboardRouter ..> MetricsService
DashboardRouter ..> AlertingService
MasterRouter ..> User
ReplenishmentService ..> ForecastModule
ReplenishmentService ..> UnitsService
OrderingService ..> InventoryService
OrderingService ..> PurchaseOrder
OrderingService ..> OrderItem
InventoryService ..> Stock
InventoryService ..> Batch
InventoryService ..> StockMovement
InventoryService ..> UnitsService
AlertingService ..> Alert
MetricsService ..> Stock
SalesDaily ..> ForecastModule : 输入
Store ..> User : 归属
Product ..> Stock
Product ..> SalesDaily
@enduml
