@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
entity "region 区域" as region {
  * id : int <<PK>>
  --
  name : str
}
entity "store 门店" as store {
  * id : int <<PK>>
  --
  # region_id : int <<FK>>
  name : str
  address : str
}
entity "user 用户" as user {
  * id : int <<PK>>
  --
  username : str <<unique>>
  password_hash : str
  full_name : str
  role : enum
  # store_id : int <<FK>>
  # region_id : int <<FK>>
  is_active : bool
}
entity "category 商品分类" as category {
  * id : int <<PK>>
  --
  name : str
}
entity "product 商品" as product {
  * id : int <<PK>>
  --
  # category_id : int <<FK>>
  name : str
  base_unit : str
  order_unit : str
  base_per_order_unit : int
  moq : int
  max_stock_base : int
  shelf_life_days : int
}
entity "unit_conversion 单位换算" as uc {
  * id : int <<PK>>
  --
  # product_id : int <<FK>>
  from_unit : str
  to_unit : str
  factor : int
}
entity "recipe BOM 菜谱" as recipe {
  * id : int <<PK>>
  --
  dish_name : str
  # product_id : int <<FK>>
  qty_base : int
}
entity "stock 库存" as stock {
  * id : int <<PK>>
  --
  # store_id : int <<FK>>
  # product_id : int <<FK>>
  qty_base : int
  locked_base : int
  in_transit_base : int
  version : int <<乐观锁>>
}
entity "batch 库存批次" as batch {
  * id : int <<PK>>
  --
  # stock_id : int <<FK>>
  qty_base : int
  produced_date : date
  expire_date : date
}
entity "stock_movement 库存流水" as movement {
  * id : int <<PK>>
  --
  # store_id : int <<FK>>
  # product_id : int <<FK>>
  movement_type : enum
  qty_base : int
  ref_no : str
  created_at : datetime
}
entity "sales_daily 日销售" as sales {
  * id : int <<PK>>
  --
  # store_id : int <<FK>>
  # product_id : int <<FK>>
  date : date
  sales_base : int
  consumed_base : int
}
entity "store_product_policy 补货策略" as policy {
  * id : int <<PK>>
  --
  # store_id : int <<FK>>
  # product_id : int <<FK>>
  lead_days : int
  service_level : float
  review_days : int
}
entity "purchase_order 订货单" as po {
  * id : int <<PK>>
  --
  order_no : str <<unique>>
  # store_id : int <<FK>>
  status : enum
  total_cents : int
  # approved_by : int <<FK>>
  remark : str
}
entity "order_item 订货明细" as oi {
  * id : int <<PK>>
  --
  # order_id : int <<FK>>
  # product_id : int <<FK>>
  order_qty : int
  suggest_qty : int
  adjust_reason : str
  received_qty : int
}
entity "alert 预警" as alert {
  * id : int <<PK>>
  --
  # store_id : int <<FK>>
  # product_id : int <<FK>>
  alert_type : enum
  severity : enum
  status : enum
  message : str
  # handled_by : int <<FK>>
}

region ||--o{ store
store ||--o{ user
category ||--o{ product
product ||--o{ uc
product ||--o{ recipe
store ||--o{ stock
product ||--o{ stock
stock ||--o{ batch
store ||--o{ movement
product ||--o{ movement
store ||--o{ sales
product ||--o{ sales
store ||--o{ policy
product ||--o{ policy
store ||--o{ po
po ||--|{ oi
product ||--o{ oi
store ||--o{ alert
product ||--o{ alert
user |o--o{ po : approved_by
user |o--o{ alert : handled_by
@enduml
