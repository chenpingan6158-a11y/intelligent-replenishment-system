  usecase "UC08 确认发货" as U08
  usecase "UC09 确认收货" as U09
  usecase "UC10 库存查询与流水" as U10
  usecase "UC11 收货入库" as U11
  usecase "UC12 领用出库" as U12
  usecase "UC13 盘点" as U13
  usecase "UC14 报损登记" as U14
  usecase "UC15 跨店调拨" as U15
  usecase "UC16 预警处理" as U16
